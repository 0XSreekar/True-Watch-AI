# TRUEWATCH — edge service environment
# Copy to .env and fill in. Never commit the real .env.
# No secret value belongs in this file.

EDGE_HOST=0.0.0.0
EDGE_PORT=8000
EDGE_LOG_LEVEL=info

# --- Where events go (Phase 8) ---
BACKEND_BASE_URL=http://localhost:4000
# Must match TRUEWATCH_INGEST_KEY in backend/.env exactly.
# Generate per deployment: openssl rand -hex 32
TRUEWATCH_INGEST_KEY=
# Delivery is on when a key is set. Bounded: timeout per try, tries per message, waiting messages.
EDGE_DELIVERY_ENABLED=true
EDGE_DELIVERY_TIMEOUT_S=3
EDGE_DELIVERY_MAX_ATTEMPTS=5
EDGE_DELIVERY_OUTBOX_MAX=1000

# --- Ingest source (Phase 1) ---
# 'rtsp' or 'file'. Reported on every event as `source`, so a replayed file is
# never presented as a live camera.
INGEST_MODE=file
RTSP_URL=
REPLAY_FILE_PATH=./var/samples/sample.mp4
# Fusion is frame-rate independent; 8 fps gives the same alerts as native 20 fps on the samples for less CPU.
TARGET_FPS=8

# --- Models (Phase 2). Weights are never committed; they are downloaded at boot. ---
# The detector is fetched over plain HTTPS without a token and verified against its SHA-256
# (models/detector_weights.py). Leave URL and SHA-256 empty in a repository checkout: the committed
# manifest training/results/hf_model.json (written by training/scripts/export_onnx.py --push-to-hub)
# supplies both. A container built from edge/ alone has no manifest; copy its resolve_url and
# sha256 into these two variables. Set both or neither.
YOLO_MODEL_URL=
YOLO_MODEL_SHA256=
YOLO_MODEL_MANIFEST=../training/results/hf_model.json
MODEL_CACHE_DIR=./models/cache
YOLO_IMG_SIZE=640
ONNX_PROVIDER=CPUExecutionProvider
OCR_MODEL_ID=
FACE_MODEL_ID=
VLM_MODEL_ID=
EMBED_MODEL_ID=
HF_TOKEN=

# --- Fusion and rules (Phases 4, 5) ---
FUSION_THRESHOLD_DEFAULT=0.55
# Motion weights. Empty = derived from docs/MEASUREMENTS.md section 1 (pipeline/fusion.py):
# day (visible) 1 - 2.74/5.17 = 0.47, night (LWIR) 1 - 0.81/2.73 = 0.70. Set a value in 0..1 to override.
NIGHT_MOTION_WEIGHT=
DAY_MOTION_WEIGHT=
LOITER_DWELL_SECONDS=3
LOITER_NET_PX=90
FENCE_X=320

# --- Evidence (Phase 9) ---
# Detection pipeline in the service loop: detector every Nth frame, per-camera calibration, event log.
DETECTOR_STRIDE=2
DETECTOR_MAX_INTERVAL_S=0.125
CALIBRATION_DIR=./var/calibration
CALIBRATION_WARMUP_SECONDS=5
CALIBRATION_WARMUP_MIN_FRAMES=25
EVENTS_LOG_PATH=
RULES_CONFIG_DIR=./var/rules
ANPR_ENABLED=true
# Plate recogniser: the fine-tune pinned in anpr/results/hf_ocr_model.json is downloaded into
# MODEL_CACHE_DIR and SHA-256 checked at first use. ANPR_DEVANAGARI_MODEL_DIR overrides it with a local
# directory; ANPR_FETCH_FINETUNED=0 disables the download (pretrained head, weaker on real plates).
ANPR_DEVANAGARI_MODEL_DIR=
ANPR_FETCH_FINETUNED=1
ANPR_OCR_MANIFEST=

# --- Camera context for the plain-language reason (Phase 6) ---
CAMERA_NAME=
CAMERA_SECTOR=

# --- Plain-language reason: local Moondream 2 (vlm/) ---
# auto = use it only if its pinned weights are already in the local Hugging Face cache; 1 = load it
# (downloading if needed); 0 = never, every reason stays the rule sentence.
VLM_ENABLED=auto
# auto (MPS on Apple silicon if available, else cpu) | cpu | mps
VLM_DEVICE=auto
# Explanation jobs waiting for the model; when full the OLDEST is dropped (its event keeps the rule sentence).
VLM_QUEUE_MAX=8
VLM_TIMEOUT_S=60
# Seconds the model rests between explanations (0 = back to back); caps how much compute it takes from the frame loop.
VLM_COOLDOWN_S=0
VLM_FRAME_MAX_SIDE=768
# DEVELOPMENT ONLY, OFF BY DEFAULT: breaks the air-gap claim and logs a warning. Needs the URL and key below.
# TRUEWATCH_VLM_HOSTED=1
# TRUEWATCH_VLM_HOSTED_URL=
# TRUEWATCH_VLM_HOSTED_KEY=

# --- Face detection on close-range person tracks (off by default: it stores personal data) ---
FACE_ENABLED=false
FACE_MIN_PERSON_HEIGHT_FRAC=0.25
FACE_STORE_DIR=./var/face_crops
# Fernet key held by the Supervisor role only. Without it only blurred crops are kept, never a clear one.
FACE_UNSEAL_KEY=

# --- Semantic footage search ---
# When on, the frame of each confirmed event and each sealed clip under SEARCH_CLIPS_DIR is indexed as it appears.
SEARCH_ENABLED=false
SEARCH_INDEX_PATH=./var/search/index.npz
SEARCH_CLIPS_DIR=./var/evidence

EVIDENCE_DIR=./var/evidence
EVIDENCE_HQ_DIR=./var/evidence-hq
# Every emitted event seals the last EVIDENCE_CLIP_SECONDS of frames (MJPEG) into the hash chain at capture.
EVIDENCE_ENABLED=true
EVIDENCE_CLIP_SECONDS=4
CLIP_SECONDS=6
