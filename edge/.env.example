# TRUEWATCH — edge service environment
# Copy to .env and fill in. Never commit the real .env.
# No secret value belongs in this file.

EDGE_HOST=0.0.0.0
EDGE_PORT=8000
EDGE_LOG_LEVEL=info

# --- Where events go (Phase 8) ---
BACKEND_BASE_URL=http://localhost:4000
# Must match TRUEWATCH_INGEST_KEY in backend/.env exactly.
# Generate per deployment: openssl rand -hex 32
TRUEWATCH_INGEST_KEY=

# --- Ingest source (Phase 1) ---
# 'rtsp' or 'file'. Reported on every event as `source`, so a replayed file is
# never presented as a live camera.
INGEST_MODE=file
RTSP_URL=
REPLAY_FILE_PATH=./var/samples/sample.mp4
TARGET_FPS=8

# --- Models (Phase 2). Weights are never committed; they are downloaded at boot. ---
# The detector is fetched over plain HTTPS without a token and verified against its SHA-256
# (models/detector_weights.py). Leave URL and SHA-256 empty in a repository checkout: the committed
# manifest training/results/hf_model.json (written by training/scripts/export_onnx.py --push-to-hub)
# supplies both. A container built from edge/ alone has no manifest; copy its resolve_url and
# sha256 into these two variables. Set both or neither.
YOLO_MODEL_URL=
YOLO_MODEL_SHA256=
YOLO_MODEL_MANIFEST=../training/results/hf_model.json
MODEL_CACHE_DIR=./models/cache
YOLO_IMG_SIZE=640
ONNX_PROVIDER=CPUExecutionProvider
OCR_MODEL_ID=
FACE_MODEL_ID=
VLM_MODEL_ID=
EMBED_MODEL_ID=
HF_TOKEN=

# --- Fusion and rules (Phases 4, 5) ---
FUSION_THRESHOLD_DEFAULT=0.55
NIGHT_MOTION_WEIGHT=0.65
LOITER_DWELL_SECONDS=3
LOITER_NET_PX=90
FENCE_X=320

# --- Evidence (Phase 9) ---
EVIDENCE_DIR=./var/evidence
CLIP_SECONDS=6
