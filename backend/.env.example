# TRUE WATCH — backend environment
# Copy to .env and adjust. Never commit the real .env.
# No secret value belongs in this file.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# --- Persistence (Phase 8) ---
# SQLite via node:sqlite. One file per post.
DATABASE_PATH=./var/truewatch.db

# --- Ingest from the edge service (Phase 8) ---
# Shared secret for POST /api/ingest/event. Must match TRUEWATCH_INGEST_KEY in
# edge/.env exactly. Generate per deployment: openssl rand -hex 32
# Ships empty on purpose: a production start with this unset must fail loudly.
TRUEWATCH_INGEST_KEY=
INGEST_MAX_SKEW_SECONDS=120
INGEST_NONCE_TTL_SECONDS=240

# --- Live stream (Phase 10) ---
# Heartbeat interval for GET /api/stream, so proxies do not drop an idle SSE
# connection.
STREAM_HEARTBEAT_SECONDS=15

# --- Session tokens (Phase 8) ---
# Ships empty on purpose. The development default in src/config/index.js is
# insecure by design and must become fatal in production.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Evidence (Phase 9) ---
EVIDENCE_STORE_PATH=./var/evidence

# --- Edge service, for health reporting only ---
EDGE_BASE_URL=http://localhost:8000
