# TRUE WATCH — backend environment
# Copy to .env and adjust. Never commit the real .env.
# No secret value belongs in this file.
#
# Development runs with every secret below left empty: src/config/index.js then uses clearly
# labelled, insecure development defaults and logs a warning. NODE_ENV=production refuses to
# start without real values for JWT_SECRET and TRUEWATCH_INGEST_KEY.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API (also checked on refresh/logout).
CORS_ORIGIN=http://localhost:5173
# Set true only when running behind a reverse proxy, so rate limits key on the real client IP.
TRUST_PROXY=false
# Maximum JSON request body.
BODY_LIMIT=100kb

# --- Persistence (Phase 8) ---
# SQLite via better-sqlite3. One file per post; created, migrated and seeded on first boot.
DATABASE_PATH=./var/truewatch.db

# --- Ingest from the edge service (Phase 8) ---
# Shared secret for POST /api/ingest/event and /api/ingest/update, sent as X-Ingest-Key.
# Must match TRUEWATCH_INGEST_KEY in edge/.env exactly. Generate per deployment:
#   openssl rand -hex 32
TRUEWATCH_INGEST_KEY=
INGEST_MAX_SKEW_SECONDS=120
INGEST_NONCE_TTL_SECONDS=240
INGEST_RATE_LIMIT_PER_MINUTE=300
# When true, every ingest request must carry X-Truewatch-Timestamp and X-Truewatch-Nonce.
# Leave false until the edge sends them; set true in any hosted deployment.
INGEST_REQUIRE_REPLAY_HEADERS=false

# --- Live stream (Phase 8 backend, Phase 10 console) ---
# Heartbeat interval for GET /api/stream, so proxies do not drop an idle connection.
STREAM_HEARTBEAT_SECONDS=15
STREAM_MAX_CLIENTS=100

# --- Sessions and authentication (Phase 8) ---
# Signing key for access tokens. Required in production (32+ characters).
JWT_SECRET=
# Access-token lifetime; the refresh cookie renews it.
JWT_EXPIRES_IN=15m
REFRESH_TTL=7d
BCRYPT_ROUNDS=10
# When true, every console endpoint answers 401 without a valid Authorization header.
# Default false: today's console sends no token. Supervisor-only endpoints are gated regardless.
AUTH_REQUIRED=false
# Demo accounts (one per role) created on first boot. Enabled by default outside production.
# Set SEED_USER_PASSWORD to choose their shared password; it is required in production.
SEED_DEMO_USERS=true
SEED_USER_PASSWORD=
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_15_MIN=30

# --- Evidence (Phase 9) ---
# Clip files are re-hashed during verification when present under this directory.
EVIDENCE_STORE_PATH=./var/evidence

# --- Edge service ---
# Used for search, evidence verification and dismiss feedback. Leave empty to run without the
# edge; each feature then falls back to the local implementation or the demo data.
EDGE_BASE_URL=http://localhost:8000
EDGE_TIMEOUT_MS=2500
EDGE_SEARCH_TIMEOUT_MS=8000

# Alert-budget shift length in hours (aligned to UTC).
SHIFT_HOURS=8
