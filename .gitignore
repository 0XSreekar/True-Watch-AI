# Dependencies
**/node_modules/

# Local configuration and secrets
**/.env
**/.env.*
!**/.env.example

# Generated output
**/dist/
**/coverage/
**/.vite/
**/var/

# Logs and local tooling
*.log
.DS_Store
.eslintcache
*.tsbuildinfo

# Local working material, never pushed
*outputs/
*.local.md
.scratch/

# Python
**/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/

# Dataset artefacts. Scripts and manifests are committed; data never is.
datasets/raw/
datasets/processed/
datasets/reports/*
!datasets/reports/.gitkeep
datasets/plates/out/
datasets/plates/labels/*
!datasets/plates/labels/.gitkeep
datasets/plates/fonts/*.ttf
datasets/plates/fonts/*.otf
datasets/plates/labels/*.txt
datasets/plates/labels/*.json
!datasets/plates/labels/.gitkeep
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.mp4
datasets/**/*.zip

# ANPR demo asset (edge/anpr/compare_latin.py renders it on demand; not data).
edge/anpr/samples/
# Kaggle packaging output (edge/anpr/scripts/package_plates_for_kaggle.py writes it).
edge/anpr/kaggle_upload/
datasets/**/*.tar
datasets/**/*.tar.gz
datasets/**/*.pt
datasets/**/*.onnx

# Model artefacts. Weights are hosted on the Hugging Face Hub and referenced by id; none is ever
# committed. Only metrics and the model URL live in git (training/results/).
*.pt
*.pth
*.onnx
*.engine
*.safetensors
training/weights/
training/runs/
# Ultralytics run folders stay inside training/. A bare **/runs/ also matched unrelated folders such as a
# future frontend/src/runs/ or backend/runs/, so it is scoped. /runs/ is the folder Ultralytics creates in
# the working directory when a training command is started from the repository root.
training/**/runs/
/runs/
training/results/cache/
