# TRUE WATCH — frontend environment (Vite: only VITE_* reaches the browser)
# Nothing secret belongs here: everything below is compiled into the public bundle.

# Base URL the app calls for the API, including the /api prefix.
#   Local development: leave as /api. The dev server proxies it to VITE_API_PROXY_TARGET, so the
#     browser sees one origin and there is no CORS to configure.
#   Production build:  set the API's public address, e.g. https://api.example.org/api
#     The API must list this site's origin in its CORS_ORIGIN. The sign-in cookie is SameSite=Strict,
#     so the site and the API must share a registrable domain (or be served from one origin behind a
#     reverse proxy) for a refreshed session to survive a page reload.
VITE_API_BASE_URL=/api

# Where the dev server proxies /api to (the backend PORT). Development only.
VITE_API_PROXY_TARGET=http://localhost:4000

VITE_PORT=5173

# Demo mode (default true). On: the console asks the API for scheduled detections, and if the API
# cannot be reached at all the sign-in and the console open on local sample data.
# Set false for a deployment that must show only real detections and must not open without a server.
VITE_DEMO_MODE=true
